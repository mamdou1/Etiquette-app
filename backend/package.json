{
  "name": "etiquettes-server",
  "version": "1.0.0",
  "description": "Backend API pour le générateur d'étiquettes",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "init-db": "node scripts/initDb.js",
    "seed-agences": "node scripts/seedAgences.js",
    "seed-boites": "node scripts/seedBoites.js",
    "setup": "npm install && npm run init-db && npm run seed-agences && npm run seed-boites"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.23.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
